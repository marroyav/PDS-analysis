#include <TF1.h>
#include <TFitResult.h>
#include <TH1D.h>
#include <TCanvas.h>
#include <TFile.h>
#include <TSystem.h>
#include <fstream>
#include <iomanip>
#include <vector>
#include <algorithm>

void fit() {
  std::ifstream input(CHARGE_PATH);
  std::vector<double> charges;
  double q;
  while(input >> q) charges.push_back(q);
  if(charges.size()<1000) { gSystem->Exit(2); return; }
  std::sort(charges.begin(),charges.end());
  double seed[3]={SEEDS};
  double gain=seed[1]-seed[0];
  double lo=std::min(charges[charges.size()/1000],seed[0]-gain);
  double hi=std::max(charges[charges.size()*999/1000],seed[2]+gain);
  TH1D h("charge","Fingerplot;Charge [ADC sample sum];Waveforms",200,lo,hi);
  for(auto v:charges) h.Fill(v);
  TF1 f("peak_fit","gaus(0)+gaus(3)+gaus(6)",seed[0]-gain,seed[2]+gain);
  for(int i=0;i<3;++i) {
    f.SetParameter(3*i,std::max(1.,h.GetBinContent(h.FindBin(seed[i]))));
    f.SetParameter(3*i+1,seed[i]);
    f.SetParameter(3*i+2,gain/5.);
    f.SetParLimits(3*i,0,charges.size());
    f.SetParLimits(3*i+1,seed[i]-.35*gain,seed[i]+.35*gain);
    f.SetParLimits(3*i+2,.01*gain,.6*gain);
  }
  TFitResultPtr result=h.Fit(&f,"SLRQ0");
  bool valid=result.Get() && result->IsValid() && result->CovMatrixStatus()>=2;
  TCanvas canvas("fingerplot","fingerplot",1000,700);
  h.Draw();f.Draw("same");canvas.SaveAs("fingerplot.png");
  TFile file("fingerplot.root","RECREATE");h.Write();f.Write();file.Close();
  std::ofstream report("fit.json");
  report << std::setprecision(12) << "{\"fit_status\":" << int(result)
    << ",\"fit_valid\":" << (valid?"true":"false")
    << ",\"pedestal_mean\":" << f.GetParameter(1)
    << ",\"pedestal_sigma\":" << f.GetParameter(2)
    << ",\"spe_mean\":" << f.GetParameter(4)
    << ",\"twope_mean\":" << f.GetParameter(7)
    << ",\"spe_separation\":" << f.GetParameter(4)-f.GetParameter(1)
    << ",\"snr_separation_over_pedestal_sigma\":"
    << (f.GetParameter(4)-f.GetParameter(1))/f.GetParameter(2) << "}\n";
  report.close();gSystem->Exit(valid?0:3);
}
